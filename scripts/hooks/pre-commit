#!/usr/bin/env bash
#
# Block commits that contain secrets, or instructions naming things that do
# not exist (scripts/check_docs.py).
#
# Enabled with:  git config core.hooksPath scripts/hooks
#
# Prefers detect-secrets (pip install detect-secrets); if it is unavailable,
# falls back to high-confidence provider patterns so the hook still catches
# the common cases rather than silently passing.
#
# Bypass with --no-verify only when you are certain a match is a false
# positive. A real key committed here is public the moment you push.
#
# Portable to bash 3.2 (the version macOS ships) - no mapfile, no assoc arrays.

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)" || exit 1
cd "$repo_root" || exit 1

# Staged text files, excluding deletions. Binary files are skipped: git reports
# them as "-" in numstat, and a pasted key cannot hide in one anyway.
staged_list="$(
  git diff --cached --numstat --diff-filter=ACMR \
    | awk -F'\t' '$1 != "-" && $2 != "-" { print $3 }'
)"
[ -z "$staged_list" ] && exit 0

# Commands and references in Claude's instructions must be real. Runs only when
# the commit touches the instructions or the code they name (~0.3s). Checks the
# working tree, so stage everything you have edited before committing.
if printf '%s\n' "$staged_list" \
    | grep -qE '^(\.claude/|CLAUDE\.md$|docs/ISSUES\.md$|runitback/|tools/|scripts/)'; then
  if [ -x "$repo_root/.venv/bin/python" ]; then
    if ! "$repo_root/.venv/bin/python" "$repo_root/scripts/check_docs.py"; then
      echo ""
      echo "pre-commit: Claude's instructions name a command, flag, function, or"
      echo "            file that does not exist (above) - commit blocked."
      echo "            Fix the instruction, or the code it refers to."
      echo ""
      exit 1
    fi
  else
    echo "pre-commit: .venv not found, skipping scripts/check_docs.py."
  fi
fi

fail() {
  echo ""
  echo "pre-commit: possible secret in staged changes - commit blocked."
  echo ""
  echo "  If it is real:  remove it, then store it outside the repo"
  echo "                  (see 'Secrets' in CLAUDE.md)"
  echo "  If it is not:   git commit --no-verify"
  echo ""
  exit 1
}

# Preferred scanner.
scanner=""
if [ -x "$repo_root/.venv/bin/detect-secrets-hook" ]; then
  scanner="$repo_root/.venv/bin/detect-secrets-hook"
elif command -v detect-secrets-hook >/dev/null 2>&1; then
  scanner="$(command -v detect-secrets-hook)"
fi

if [ -n "$scanner" ]; then
  # shellcheck disable=SC2086
  if ! printf '%s\n' "$staged_list" | tr '\n' '\0' | xargs -0 "$scanner"; then
    fail
  fi
  exit 0
fi

echo "pre-commit: detect-secrets not found, using built-in patterns only."
echo "            (pip install detect-secrets for full coverage)"

added_lines="$(printf '%s\n' "$staged_list" | tr '\n' '\0' \
  | xargs -0 git diff --cached -U0 -- | grep '^+' || true)"
[ -z "$added_lines" ] && exit 0

hit=0
while IFS= read -r pattern; do
  [ -z "$pattern" ] && continue
  matches="$(printf '%s\n' "$added_lines" | grep -oE -- "$pattern" | head -3 || true)"
  if [ -n "$matches" ]; then
    echo ""
    echo "  matched: $pattern"
    printf '%s\n' "$matches" | sed -E 's/(.{12}).*/\1... (redacted)/'
    hit=1
  fi
done <<'PATTERNS'
AIza[0-9A-Za-z_-]{35}
sk-ant-[0-9A-Za-z_-]{20,}
sk-[0-9A-Za-z]{32,}
gh[pousr]_[0-9A-Za-z]{36,}
AKIA[0-9A-Z]{16}
-----BEGIN [A-Z ]*PRIVATE KEY-----
PATTERNS

[ "$hit" -eq 1 ] && fail
exit 0
